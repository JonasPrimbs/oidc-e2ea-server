{
  "root": "/run/secrets/ca_root_cert",
  "federatedRoots": null,
  "crt": "/run/secrets/ca_intermediate_cert",
  "key": "/run/secrets/ca_intermediate_key",
  "address": ":443",
  "dnsNames": [
    "$CA_HOST"
  ],
  "logger": {
    "format": "text",
    "level": "info"
  },
  "crl": {
    "enabled": false
  },
  "db": {
    "type": "postgresql"
  },
  "policy": {
    "x509": {
      "allow": {
        "dns": [
          "$CA_HOST",
          "$OP_HOST"
        ]
      },
      "allowWildcardNames": false
    }
  },
  "authority": {
    "provisioners": [
      {
        "type": "ACME",
        "name": "internal"
      }
    ]
  }
}